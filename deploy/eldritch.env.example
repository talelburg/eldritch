# The server's environment. Copy to /etc/eldritch/eldritch.env (docs/deploy.md).
# The variables are read by crates/server/src/config.rs.

# Caddy is the only thing that talks to the server, so it listens on loopback.
# deploy/Caddyfile and scripts/deploy.sh name this same port.
ELDRITCH_BIND=127.0.0.1:8000

# Through the `current` symlink, so a deploy never edits this file.
ELDRITCH_DIST=/srv/eldritch/current/dist

# scripts/deploy.sh backs up and inspects this same file, and names its path,
# as does the `server accounts` command in docs/deploy.md.
DATABASE_URL=sqlite:///srv/eldritch/data/eldritch.db

# Sign-in providers: docs/deploy.md, "Sign-in providers", says where each value
# comes from. A provider is on when both its id and its secret are set, and
# the server refuses to start with only one of them, or with a provider on and
# no public origin. Every provider's callback is built from the public origin.
#ELDRITCH_PUBLIC_ORIGIN=https://eldritch.gripe
#ELDRITCH_GITHUB_CLIENT_ID=
#ELDRITCH_GITHUB_CLIENT_SECRET=
